{
  "info": {
    "name": "Public Services Portal — REST API v1",
    "description": "Postman collection for the Laravel + Sanctum portal.\n\nHow to use it\n1. Set `base_url` (default `http://services-portal/api/v1` for the Wamp.NET vhost, or `http://127.0.0.1:8000/api/v1` for `php artisan serve`).\n2. Run **01 Auth → Login as administrator**. The test script stores the bearer token in the collection variable `token`, so every later request is authenticated automatically.\n3. Work through the folders in order: filing a case needs a citizen token, moving it needs an officer token, approving it needs the admin token.\n4. `docs/openapi.yaml` in the repo is the contract this collection was written against, and it is served at `/api/v1/openapi.yaml`.\n\nSeeded demo accounts (password `password`): `admin@portal.local`, `officer@portal.local`, `citizen@portal.local`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://services-portal/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "service_type_id",
      "value": "3"
    },
    {
      "key": "application_id",
      "value": "1"
    },
    {
      "key": "reference",
      "value": "PSP-2026-000001"
    },
    {
      "key": "document_id",
      "value": "1"
    },
    {
      "key": "user_id",
      "value": "2"
    },
    {
      "key": "department_id",
      "value": "1"
    },
    {
      "key": "officer_role_id",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "00 Anonymous",
      "item": [
        {
          "name": "Meta — capabilities and statuses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/meta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "meta"
              ]
            },
            "description": "Public. Returns the reference prefix, the live-poll interval and the workflow vocabulary."
          },
          "response": []
        },
        {
          "name": "Track a case by reference",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('reference is masked, not exposed', () => {",
                  "    pm.expect(body.data.applicant_name).to.include('***');",
                  "});",
                  "pm.test('no contact details leak', () => {",
                  "    pm.expect(body.data).to.not.have.property('applicant_phone');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/track?reference={{reference}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "track"
              ],
              "query": [
                {
                  "key": "reference",
                  "value": "{{reference}}"
                }
              ]
            },
            "description": "Throttled to 30 lookups per minute. The name stays masked until the optional citizen number proves ownership."
          },
          "response": []
        },
        {
          "name": "Track with ownership proof",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/track?reference={{reference}}&national_id=3000000001",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "track"
              ],
              "query": [
                {
                  "key": "reference",
                  "value": "{{reference}}"
                },
                {
                  "key": "national_id",
                  "value": "3000000001"
                }
              ]
            },
            "description": "Sets meta.owner_verified and reveals the full timeline."
          },
          "response": []
        },
        {
          "name": "Track an unknown reference (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/track?reference=PSP-2026-999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "track"
              ],
              "query": [
                {
                  "key": "reference",
                  "value": "PSP-2026-999999"
                }
              ]
            },
            "description": "Misses are audited as tracking_miss with the reference only — never with the guess that failed."
          },
          "response": []
        },
        {
          "name": "Services catalogue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/services",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "services"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Departments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/departments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "departments"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Status legend",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/statuses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "statuses"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register a citizen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('citizen_token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amina Yusuf\",\n  \"email\": \"amina+{{random}}@example.com\",\n  \"password\": \"Passw0rd123\",\n  \"password_confirmation\": \"Passw0rd123\",\n  \"phone\": \"+1 555 0100\",\n  \"national_id\": \"3100000001\",\n  \"terms\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Rate limited to 5 per minute per IP. Password needs 8 characters with letters and numbers; the citizen number is 10 digits and unique."
          },
          "response": []
        },
        {
          "name": "Login as administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.data.token);",
                  "pm.test('token carries the admin abilities', () => {",
                  "    pm.expect(json.data.abilities).to.include('users:manage');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@portal.local\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Stores the bearer token in the collection variable `token`. A failed attempt is written to the audit trail as login_failed."
          },
          "response": []
        },
        {
          "name": "Login as case officer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"officer@portal.local\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Replaces `token`, so the following requests run with officer scope. Officers get applications:read, applications:decide and audit:read — never users:manage."
          },
          "response": []
        },
        {
          "name": "Login as citizen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@portal.local\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Profile, role, derived abilities and the counters shown in the header."
          },
          "response": []
        },
        {
          "name": "Refresh the token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Issues a new token and revokes the one used for the call."
          },
          "response": []
        },
        {
          "name": "Wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@portal.local\",\n  \"password\": \"not-the-password\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout (revokes this token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Run last: after this the stored token no longer authenticates. Other devices stay signed in."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Applications",
      "item": [
        {
          "name": "File an application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "    pm.collectionVariables.set('application_id', json.data.id);",
                  "    pm.collectionVariables.set('reference', json.data.reference_number);",
                  "}",
                  "pm.test('reference looks like PSP-YYYY-NNNNNN', () => {",
                  "    pm.expect(json.data.reference_number).to.match(/^PSP-\\d{4}-\\d{6}$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_type_id\": {{service_type_id}},\n  \"title\": \"Renewal of my national identity card\",\n  \"description\": \"My card expires next month and the counter requires an appointment before renewal.\",\n  \"applicant_name\": \"Amina Yusuf\",\n  \"applicant_phone\": \"+1 555 0100\",\n  \"applicant_address\": \"12 Riverside Road, Block C, Apt 4\",\n  \"notes\": \"Available after 3pm for any check.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications"
              ]
            },
            "description": "Sign in as a citizen first. Creates the case in `submitted`, sets the SLA due date from the service turnaround and returns the tracking reference."
          },
          "response": []
        },
        {
          "name": "List the cases I may see",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications?state=open&sort=due&per_page=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "open"
                },
                {
                  "key": "sort",
                  "value": "due"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Scoping is by role: a citizen sees their own filings, an officer the department queue, an admin everything. Other filters: status, department_id, service_type_id, assigned_officer_id, priority, q."
          },
          "response": []
        },
        {
          "name": "Read one case",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}"
              ]
            },
            "description": "Includes documents, comments, timeline and the moves the caller may still make."
          },
          "response": []
        },
        {
          "name": "Amend a submitted case",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant_phone\": \"+1 555 0144\",\n  \"applicant_address\": \"14 Riverside Road, Block A, Apt 9\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}"
              ]
            },
            "description": "Only while the case is still `submitted` and nothing has been verified. Staff may also change priority; a citizen sending it gets 422."
          },
          "response": []
        },
        {
          "name": "Withdraw a case",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}"
              ]
            },
            "description": "Soft delete: the audit trail keeps its history and the reference stays searchable as cancelled."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 Workflow",
      "item": [
        {
          "name": "Status options for my role",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}/status-options",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}",
                "status-options"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Move to under review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "application/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('stage advanced', () => pm.expect(json.data.stage).to.be.above(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"under_review\",\n  \"note\": \"Documents matched the registry entry; opening the file for review.\",\n  \"internal_only\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}",
                "status"
              ]
            },
            "description": "Sign in as the officer first. The transition, the timeline entry and the audit row are written in one transaction; the first officer to act claims the case."
          },
          "response": []
        },
        {
          "name": "Ask for more paperwork",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"documents_required\",\n  \"note\": \"The proof of address is older than three months.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}",
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Keep a note internal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"on_hold\",\n  \"note\": \"Waiting for the external registry to answer.\",\n  \"internal_only\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}",
                "status"
              ]
            },
            "description": "internal_only hides the note from the citizen timeline."
          },
          "response": []
        },
        {
          "name": "Illegal jump (422 workflow_violation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"note\": \"Should be refused by the workflow engine.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}",
                "status"
              ]
            },
            "description": "An edge that does not exist in config/portal.php returns { message, code: workflow_violation } and the case does not move."
          },
          "response": []
        },
        {
          "name": "Admin approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"note\": \"Sign-off after the final check.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications",
                "{{application_id}}",
                "status"
              ]
            },
            "description": "Sign in as admin: pending_approval can only be decided by an administrator."
          },
          "response": []
        },
        {
          "name": "Assign another officer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
