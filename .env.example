APP_NAME="Public Services Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Wamp.NET vhost: http://services-portal (add "127.0.0.1 services-portal" to hosts, or use artisan serve)
APP_URL=http://services-portal

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB/MySQL shipped with Wamp.NET
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=services_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie-auth (Inertia) + bearer tokens (Sanctum REST API)
SANCTUM_STATEFUL_DOMAINS=services-portal,localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@portal.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Portal domain configuration (config/portal.php) -----------------------
PORTAL_REFERENCE_PREFIX=PSP
PORTAL_DEFAULT_SLA_DAYS=15
PORTAL_TRACKING_POLL_SECONDS=15
PORTAL_MAX_DOCUMENT_KILOBYTES=10240
